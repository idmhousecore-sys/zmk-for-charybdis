#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    combos {
        compatible = "zmk,combos";

        rbl {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <27 28>;
        };

        rbr {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <31 32>;
        };

        qbl {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <39 40>;
        };

        qbr {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <43 44>;
        };

        fbl {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <16 15>;
        };

        fbr {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <19 20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            bindings = <
&kp ESCAPE      &kp N1  &kp N2  &kp N3              &kp N4        &kp N5            &kp N6     &kp N7                    &kp N8     &kp N9   &kp N0         &kp BACKSLASH
&kp TAB         &kp Q   &kp W   &kp E               &kp R         &kp T             &kp Y      &kp U                     &kp I      &kp O    &kp P          &kp SQT
&kp LEFT_SHIFT  &kp A   &kp S   &kp D               &kp F         &kp G             &kp H      &kp J                     &kp K      &kp L    &kp SEMICOLON  &kp SQT
&kp LCTRL       &kp Z   &kp X   &kp C               &kp V         &kp B             &kp N      &kp M                     &kp COMMA  &kp DOT  &lt 3 SLASH    &kp ESCAPE
                                &mt LEFT_ALT SPACE  &kp LEFT_GUI  &lt 1 QUESTION    &mo 2      &mt LEFT_SHIFT BACKSPACE
                                                    &lt 2 TAB     &kp MINUS         &kp ENTER
            >;
        };

        Lower {
            bindings = <
&kp TILDE  &kp EXCLAMATION  &kp HASH      &kp DOLLAR    &kp DOLLAR    &kp PERCENT    &kp CARET      &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PIPE
&kp GRAVE  &kp NUMBER_1     &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp LBKT       &kp RBKT       &kp F1         &kp F2        &kp F3                &kp F4                 &kp BACKSPACE
&kp LSHFT  &kp NUMBER_5     &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &none          &kp BACKSLASH  &kp F5         &kp F6        &kp F7                &kp F8                 &kp PAGE_UP
&kp LCTRL  &kp NUMBER_9     &kp NUMBER_0  &kp MINUS     &kp EQUAL     &none          &none          &kp F9         &kp F10       &kp F11               &kp F12                &kp PAGE_DOWN
                                          &kp LEFT_WIN  &kp LEFT_GUI  &trans         &kp ENTER      &kp RIGHT_ALT
                                                        &none         &none          &none
            >;
        };

        Raise {
            bindings = <
&kp F12        &kp F1      &kp F2      &kp F3              &kp F4         &kp F5          &kp F6  &kp F7                    &kp F8        &kp F9     &kp F10  &kp F11
&kp LS(GRAVE)  &kp LS(N1)  &kp LS(N2)  &kp LS(N3)          &kp LS(N4)     &kp LS(LBKT)    &none   &none                     &kp UP_ARROW  &none      &none    &none
&kp LSHFT      &kp LS(N5)  &kp LS(N6)  &kp D               &kp LS(N8)     &none           &none   &kp LEFT                  &kp DOWN      &kp RIGHT  &none    &none
&kp LCTRL      &kp LS(N9)  &kp LS(N0)  &kp LS(MINUS)       &kp LS(EQUAL)  &none           &none   &none                     &none         &none      &none    &none
                                       &mt LEFT_ALT SPACE  &kp LEFT_GUI   &kp ENTER       &mo 0   &mt LEFT_SHIFT BACKSPACE
                                                           &none          &none           &none
            >;
        };

        Mouse {
            bindings = <
&none        &none  &none      &none               &none         &none    &none           &none                     &none         &none         &none         &none
&none        &none  &none      &none               &none         &none    &bt BT_CLR      &none                     &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &none
&none        &none  &mkp LCLK  &mo 4               &mkp RCLK     &none    &none           &mkp LCLK                 &mo 4         &mkp RCLK     &none         &none
&bootloader  &none  &none      &none               &none         &none    &studio_unlock  &none                     &none         &none         &none         &bootloader
                               &mt LEFT_ALT SPACE  &kp LEFT_GUI  &none    &mo 2           &mt LEFT_SHIFT BACKSPACE
                                                   &none         &none    &kp ENTER
            >;
        };

        Scroll {
            bindings = <
&none        &none  &none      &none  &none      &none    &none       &none      &none         &none         &none         &none
&none        &none  &none      &none  &none      &none    &bt BT_CLR  &none      &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &none
&none        &none  &mkp LCLK  &mo 3  &mkp RCLK  &none    &none       &mkp LCLK  &mo 3         &mkp RCLK     &none         &none
&bootloader  &none  &none      &none  &none      &none    &none       &none      &none         &none         &none         &bootloader
                               &none  &none      &none    &none       &none
                                      &none      &none    &none
            >;
        };
    };
};
