#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    combos {
        compatible = "zmk,combos";

        rbl {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <27 28>;
        };

        rbr {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <31 32>;
        };

        qbl {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <39 40>;
        };

        qbr {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <43 44>;
        };

        fbl {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <16 15>;
        };

        fbr {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <19 20>;
        };

        minus {
            bindings = <&kp MINUS>;
            key-positions = <31 30>;
        };

        backslash {
            bindings = <&kp BACKSLASH>;
            key-positions = <18 19>;
        };

        question {
            bindings = <&kp QUESTION>;
            key-positions = <28 29>;
        };

        plus {
            bindings = <&kp PLUS>;
            key-positions = <14 15>;
        };

        equal {
            bindings = <&kp EQUAL>;
            key-positions = <27 26>;
        };

        semico {
            bindings = <&kp SEMICOLON>;
            key-positions = <41 40>;
        };

        colon {
            bindings = <&kp COLON>;
            key-positions = <42 43>;
        };

        tilda {
            bindings = <&kp TILDE>;
            key-positions = <39 38>;
        };

        apost {
            bindings = <&kp SQT>;
            key-positions = <32 33>;
        };

        double {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <21 20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            bindings = <
&kp ESCAPE                            &kp N1  &kp N2  &kp N3        &kp N4                  &kp N5        &kp N6     &kp N7                &kp N8     &kp N9   &kp N0         &kp BACKSLASH
&kp GLOBE                             &kp Q   &kp W   &kp E         &kp R                   &kp T         &kp Y      &kp U                 &kp I      &kp O    &kp P          &kp SQT
&kp C_AC_NEXT_KEYBOARD_LAYOUT_SELECT  &kp A   &kp S   &kp D         &kp F                   &kp G         &kp H      &kp J                 &kp K      &kp L    &kp SEMICOLON  &kp SQT
&kp LCTRL                             &kp Z   &kp X   &kp C         &kp V                   &kp B         &kp N      &kp M                 &kp COMMA  &kp DOT  &lt 3 SLASH    &mo 5
                                                      &kp LEFT_GUI  &mt LEFT_ALT BACKSPACE  &to 2         &kp TAB    &mt LEFT_SHIFT SPACE
                                                                    &mo 2                   &kp LC(UP)    &kp ENTER
            >;
        };

        Lower {
            bindings = <
&kp TILDE  &kp EXCLAMATION  &kp HASH      &kp DOLLAR    &kp DOLLAR    &kp PERCENT    &kp CARET      &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PIPE
&kp GRAVE  &kp NUMBER_1     &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp LBKT       &kp RBKT       &kp F1         &kp F2        &kp F3                &kp F4                 &kp BACKSPACE
&kp LSHFT  &kp NUMBER_5     &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &none          &kp BACKSLASH  &kp F5         &kp F6        &kp F7                &kp F8                 &kp PAGE_UP
&kp LCTRL  &kp NUMBER_9     &kp NUMBER_0  &kp MINUS     &kp EQUAL     &none          &none          &kp F9         &kp F10       &kp F11               &kp F12                &kp PAGE_DOWN
                                          &kp LEFT_WIN  &kp LEFT_GUI  &trans         &kp ENTER      &kp RIGHT_ALT
                                                        &none         &none          &none
            >;
        };

        Raise {
            bindings = <
&kp F12        &kp F1      &kp F2      &kp F3         &kp F4                  &kp F5          &kp F6     &kp F7                &kp F8        &kp F9     &kp F10  &kp F11
&kp LS(GRAVE)  &kp LS(N1)  &kp LS(N2)  &kp LS(N3)     &kp LS(N4)              &kp LS(LBKT)    &none      &none                 &kp UP_ARROW  &none      &none    &none
&kp LSHFT      &kp LS(N5)  &kp LS(N6)  &kp D          &kp LS(N8)              &none           &none      &kp LEFT              &kp DOWN      &kp RIGHT  &none    &none
&kp LCTRL      &kp LS(N9)  &kp LS(N0)  &kp LS(MINUS)  &kp LS(EQUAL)           &none           &none      &none                 &none         &none      &none    &none
                                       &kp LEFT_GUI   &mt LEFT_ALT BACKSPACE  &to 0           &kp TAB    &mt LEFT_SHIFT SPACE
                                                      &none                   &kp LC(UP)      &kp ENTER
            >;
        };

        Mouse {
            bindings = <
&none        &none  &none      &none         &none                   &none         &none           &none                 &none  &none      &none  &none
&none        &none  &none      &none         &none                   &none         &none           &none                 &none  &none      &none  &none
&none        &none  &mkp LCLK  &mo 4         &mkp RCLK               &none         &none           &mkp LCLK             &mo 4  &mkp RCLK  &none  &none
&bootloader  &none  &none      &none         &none                   &none         &studio_unlock  &none                 &none  &none      &none  &bootloader
                               &kp LEFT_GUI  &mt LEFT_ALT BACKSPACE  &to 2         &kp TAB         &mt LEFT_SHIFT SPACE
                                             &mo 2                   &kp LC(UP)    &kp ENTER
            >;
        };

        Scroll {
            bindings = <
&none        &none  &none      &none  &none      &none    &none  &none      &none  &none      &none  &none
&none        &none  &none      &none  &none      &none    &none  &none      &none  &none      &none  &none
&none        &none  &mkp LCLK  &none  &mkp RCLK  &none    &none  &mkp LCLK  &none  &mkp RCLK  &none  &none
&bootloader  &none  &none      &none  &none      &none    &none  &none      &none  &none      &none  &bootloader
                               &none  &none      &none    &none  &none
                                      &none      &none    &none
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans      &trans  &trans  &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans    &bt BT_CLR  &trans  &trans  &bt BT_SEL 1  &bt BT_SEL 0  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans      &trans  &trans  &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans      &trans  &trans  &trans        &trans        &trans
                        &trans  &trans  &trans    &trans      &trans
                                &trans  &trans    &trans
            >;
        };
    };
};
